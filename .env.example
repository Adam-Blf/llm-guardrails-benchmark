# Copy to .env and fill in. Never commit .env.

# Lakera Guard API key (https://platform.lakera.ai). Without it the Lakera
# adapter is skipped and the reason is written to results/tools_status.json.
LAKERA_API_KEY=

# Hugging Face token. Only needed for gated models such as
# meta-llama/Prompt-Guard-86M (licence acceptance required on the Hub).
HF_TOKEN=

# Ollama endpoint used by the Llama Guard and NeMo Guardrails adapters.
OLLAMA_HOST=http://127.0.0.1:11434
